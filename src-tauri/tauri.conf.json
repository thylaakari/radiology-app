{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "radiology-hub",
  "version": "1.0.2",
  "identifier": "com.thyla.radiology-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Radiology Hub",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGOEIzODMwNzVCMjQ1QUIKUldTclJiSjFNRGlMNzIxNFgxTlo0a3lBQjZ3dXRDLzBIalRIWlkxL054OHM3MVk4c1cyaUJVdUsK",
      "endpoints": ["https://radiologyhub.ru/updates/latest.json"]
    }
  }
}
